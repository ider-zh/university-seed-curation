    "summary": {
      "candidates": [
        {
          "evidence": [
            {
              "locator": "metadata",
              "original_text": "{\"id\": \"Q7427529\", \"labels\": {\"en\": \"Saurashtra University\"}, \"descriptions\": {\"en\": \"state public university in Rajkot, Gujarat, India\"}}",
              "source_ref": "s1"
            },
            {
              "locator": "section:lead",
              "original_text": "The Saurashtra University is one of the significant universities in Gujarat state in India. This university was established on 23 May 1967, in Rajkot city, and the administrative headquarters are at Rajkot. Presently, 272 colleges in Amreli, Jamnagar, Junagadh, Porbandar, Rajkot and Surendranagar districts are affiliated with the Saurashtra University.",
              "source_ref": "s2"
            },
            {
              "locator": "infobox:2",
              "original_text": "Affiliations: UGC",
              "source_ref": "s2"
            },
            {
              "locator": "infobox:6",
              "original_text": "Campus: Urban",
              "source_ref": "s2"
            },
            {
              "locator": "claim:P1451:0",
              "original_text": "{\"property\": \"P1451\", \"property_label\": \"motto text\", \"statement_id\": \"Q7427529$2fd6ad16-4c42-a8b2-496c-e6381824f3c5\", \"rank\": \"normal\", \"snaktype\": \"value\", \"value\": {\"text\": \"पावका नः सरस्वती\", \"language\": \"sa\"}}",
              "source_ref": "s1"
            }
          ],
          "id": "c1",
          "value": {
            "language": "en",
            "text": "Saurashtra University is a state public university in Rajkot, Gujarat, India. It was established in Rajkot on 23 May 1967, and its administrative headquarters are in the same city. The university’s Sanskrit motto is “पावका नः सरस्वती”.\n\nThe university has an affiliating role across several districts of Gujarat. An undated count records 272 colleges affiliated with Saurashtra University in Amreli, Jamnagar, Junagadh, Porbandar, Rajkot and Surendranagar districts. This figure describes affiliated colleges rather than the university’s student population or the number of its campuses. Its listed institutional affiliation is UGC, and its campus setting is described as urban."
          },
          "verification": "supported"
        }
      ],
