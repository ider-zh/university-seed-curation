              "original_text": "{\"property\": \"P749\", \"property_label\": \"parent organization or unit\", \"statement_id\": \"Q11586497$6ae1e418-4cf6-5b4d-a6ff-4bce072e42b3\", \"rank\": \"normal\", \"snaktype\": \"value\", \"value\": {\"entity-type\": \"item\", \"numeric-id\": 118140254, \"id\": \"Q118140254\"}}",
