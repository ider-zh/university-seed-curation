  "profile": {
    "summary": {
      "candidates": [
        {
          "evidence": [
            {
              "locator": "section:lead",
              "original_text": "The Queen's University of Ireland was established formally by royal charter on 3 September 1850, as the degree-awarding university of the Queen's Colleges of Belfast, Cork, and Galway",
              "source_ref": "s2"
            },
            {
              "locator": "section:Establishment",
              "original_text": "The colleges were incorporated on 30 December 1845; and on 30 October 1849 they opened for students.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Establishment",
              "original_text": "the Queen's Colleges were not permitted to give instruction in theology",
              "source_ref": "s2"
            },
            {
              "locator": "section:Establishment",
              "original_text": "A Board of Queen's Colleges was created to draw up regulations for the colleges, consisting of the President and Vice-President of each college.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Establishment",
              "original_text": "Academic degrees were conferred by the chancellor and senate of the university",
              "source_ref": "s2"
            },
            {
              "locator": "section:Dissolution",
              "original_text": "The Queen's University was superseded by a new, inclusive, degree-awarding institution, the Royal University of Ireland in 1880.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Dissolution",
              "original_text": "The Queen's University was formally dissolved on 3 February 1882.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Dissolution",
              "original_text": "The Belfast college was separated from the other two in 1908, and became The Queen's University of Belfast (QUB).",
              "source_ref": "s2"
            },
            {
              "locator": "section:Dissolution",
              "original_text": "Queen's College, Cork is now University College Cork (UCC), while Queen's College Galway is now the University of Galway.",
              "source_ref": "s2"
            }
          ],
          "id": "c1",
          "value": {
            "language": "en",
            "text": "Queen's University of Ireland was a public university in Ireland associated with colleges in Belfast, Cork and Galway. Established by royal charter on 3 September 1850, it awarded degrees for the three Queen's Colleges. These colleges had been established in 1845 and opened to students on 30 October 1849. They were intended to provide university education to members of all religious denominations.\n\nThe colleges were not permitted to teach theology. A board comprising each college's president and vice-president drew up their regulations, while the university's chancellor and senate conferred degrees. In 1880 the Royal University of Ireland superseded Queen's University, which was formally dissolved on 3 February 1882. The Belfast college became Queen's University of Belfast in 1908; the Cork and Galway colleges are now University College Cork and the University of Galway."
          },
          "verification": "supported"
        }
      ],
      "preferred": {
        "candidate_id": "c1",
        "reason_code": "only_available"
      }
    }
  },
