    "summary": {
      "candidates": [
        {
          "evidence": [
            {
              "locator": "section:lead",
              "original_text": "The Klement Gottwald Military Political Academy (Czech: Vojenská politická akademie Klementa Gottwalda, abbreviation VPA KG) was a military academy under the Main Political Administration of the Czechoslovak People's Army. It was based in Bratislava, the capital of the Slovak Socialist Republic",
              "source_ref": "s2"
            },
            {
              "locator": "section:History",
              "original_text": "Its predecessor institution was a military political school first located in Prague, from 1953 to 1969.",
              "source_ref": "s2"
            },
            {
              "locator": "section:History",
              "original_text": "After the abolition of the academy in Prague, the so-called Faculty of Social Sciences in Bratislava was established on 1 September 1969, forming part of the Antonín Zápotocký Military Academy in Brno (currently the University of Defence).",
              "source_ref": "s2"
            },
            {
              "locator": "section:History",
              "original_text": "On 31 August 1972, this faculty was abolished and on its basis the Military Political Academy in Bratislava was established on 1 September 1972. After the Velvet Revolution, it was renamed the Higher Military Pedagogical School. In 1993, the school was merged with the Military Technical School under the name Military Academy in Liptovský Mikuláš.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Academics",
              "original_text": "The academy was one of the few schools whose graduates received the title of Doctor of Social and Political Sciences. Graduates worked as political instructors, supervisory officers responsible for the political education (ideology) of the units on behalf of the Communist Party of Czechoslovakia.",
              "source_ref": "s2"
            }
          ],
          "id": "c1",
          "value": {
            "language": "en",
            "text": "The Klement Gottwald Military Political Academy (Vojenská politická akademie Klementa Gottwalda, VPA KG) was a military academy based in Bratislava, then in the Slovak Socialist Republic within Czechoslovakia. It operated under the Main Political Administration of the Czechoslovak People’s Army and prepared cadres for its political apparatus.\n\nIts institutional history included a predecessor military political school located in Prague from 1953 to 1969 and a Faculty of Social Sciences established in Bratislava in 1969 as part of the Antonín Zápotocký Military Academy in Brno. The faculty was abolished on 31 August 1972, and the academy was established on its basis on 1 September 1972. After the Velvet Revolution, the academy was renamed the Higher Military Pedagogical School; in 1993 that school merged with the Military Technical School as the Military Academy in Liptovský Mikuláš. The academy’s graduates could receive the title Doctor of Social and Political Sciences and worked in political education roles."
          },
          "verification": "supported"
        }
      ],
      "preferred": {
        "candidate_id": "c1",
        "reason_code": "only_available"
      }
    }
  },
