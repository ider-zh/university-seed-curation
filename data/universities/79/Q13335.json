              "locator": "claim:P2196:3",
              "original_text": "{\"property\": \"P2196\", \"property_label\": \"count of students\", \"statement_id\": \"Q13335$ae95575d-e9c2-4e9d-b77d-08c3753345f5\", \"rank\": \"normal\", \"snaktype\": \"value\", \"value\": {\"amount\": \"+17635\", \"unit\": \"1\"}, \"qualifiers\": {\"P585\": [{\"snaktype\": \"value\", \"value\": {\"time\": \"+2013-01-01T00:00:00Z\", \"timezone\": 0, \"before\": 0, \"after\": 0, \"precision\": 9, \"calendarmodel\": \"http://www.wikidata.org/entity/Q1985727\"}}]}, \"reference_count\": 1}",
