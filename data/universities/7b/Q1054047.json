    "summary": {
      "candidates": [
        {
          "evidence": [
            {
              "locator": "section:lead",
              "original_text": "Public university in Bloemfontein, South Africa\nThe Central University of Technology, Free State (CUT) is a public technology university with campuses in Bloemfontein and Welkom, Free State province, South Africa.\nIt was established in 1981 as \"Technikon Free State.\" As part of the South African government's restructuring of tertiary education for the new millennium it was promoted to university of technology status.\nIt is currently part of the BRICS Universities League, a consortium of leading research universities from Brazil, Russia, India, China, and South Africa.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Campus",
              "original_text": "The university has two campuses – one in Bloemfontein, the judicial capital of South Africa, and one in Welkom, in the heart of the Free State goldfields.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Faculties",
              "original_text": "Faculty of Engineering, Built Environment and Information Technology\nFaculty of Health and Environmental Sciences\nFaculty of Humanities\nFaculty of Management Sciences",
              "source_ref": "s2"
            },
            {
              "locator": "section:Student_enrollment",
              "original_text": "The university offers certificates and diplomas at undergraduate level, as well as advanced diplomas, postgraduate diplomas at honours level, and master's and doctoral degrees.",
              "source_ref": "s2"
            },
            {
              "locator": "section:Academics",
              "original_text": "The Central University of Technology employs over 800 academic and research staff spread across four faculties.",
              "source_ref": "s2"
            },
            {
              "locator": "infobox:6",
              "original_text": "Students: 21 993",
              "source_ref": "s2"
            },
            {
              "locator": "infobox:5",
              "original_text": "Administrative staff: 1 100",
              "source_ref": "s2"
            },
            {
              "locator": "claim:P1128:0",
              "original_text": "{\"property\": \"P1128\", \"property_label\": \"employees\", \"statement_id\": \"Q1054047$BD70A56E-DFF5-4FFF-A378-7CD0ED0878D3\", \"rank\": \"normal\", \"snaktype\": \"value\", \"value\": {\"amount\": \"+1500\", \"unit\": \"1\"}, \"reference_count\": 1}",
