              "locator": "claim:P625:0",
              "original_text": "{\"property\": \"P625\", \"property_label\": \"coordinate location\", \"statement_id\": \"Q1060$e97e12e1-463f-982b-9246-2586c1cc4486\", \"rank\": \"normal\", \"snaktype\": \"value\", \"value\": {\"latitude\": 53.460958333333, \"longitude\": 9.9695055555556, \"altitude\": null, \"precision\": 2.7777777777778e-06, \"globe\": \"http://www.wikidata.org/entity/Q2\"}}",
