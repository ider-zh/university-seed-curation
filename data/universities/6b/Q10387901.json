    "summary": {
      "candidates": [
        {
          "evidence": [
            {
              "locator": "section:lead",
              "original_text": "É uma universidade comunitária, de caráter regional, filiada à Associação Brasileira das Instituições Comunitárias de Educação Superior (Abruc), não confessional, mantida pela Fundação Dom Aguirre (FDA)",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Sua história está relacionada à trajetória da Faculdade de Filosofia, Ciências e Letras de Sorocaba, que surgiu em 1951 dentre as instituições pioneiras no Ensino Superior do município.",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Em 7 de março de 1954, a FAFI entrou efetivamente em funcionamento, com os cursos de Pedagogia e Letras Neolatinas, nos quais estavam matriculados 27 alunos.",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "a Universidade de Sorocaba (Uniso) foi a primeira universidade implantada na Região, em 15 de setembro de 1994.",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Como parte do processo de diversificação dos cursos oferecidos pela FAFI, surgiu a Faculdade de Administração e Ciências Contábeis de Sorocaba (FACCAS).",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Mestrado e Doutorado em Ciências Farmacêuticas, em Comunicação e Cultura, em Educação, e em Processos Tecnológicos e Ambientais",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Atende a cerca de oito mil alunos no câmpus Trujillo e Cidade Universitária “Professor Aldo Vannucchi”.",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Possui mais de cem laboratórios para atividades de ensino e desenvolvimento de pesquisa científica.",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Saúde, Educação, Cultura, Direitos Humanos e Justiça, Comunicação, Meio Ambiente, Tecnologia e Trabalho.",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "Criado em 2021, o Uniso Tech, Parque Tecnológico da Uniso",
              "source_ref": "s2"
            },
            {
              "locator": "section:lead",
              "original_text": "O Parque oferece suporte técnico ao desenvolvimento das empresas de Sorocaba e Região.",
              "source_ref": "s2"
            },
            {
