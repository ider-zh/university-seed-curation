        "summary": {
          "candidates": [
            {
              "evidence": [
                {
                  "locator": "section:lead",
                  "original_text": "Burhan Academy is a private Islamic school located in Elgin, Illinois, United States. It occupies the historic campus of the former Elgin Academy, a 185-year-old independent school that closed in 2024. Founded by Yasir Nadeem al Wajidi, Burhan Academy has an Islamic style education.",
                  "source_ref": "s2"
                },
                {
                  "locator": "section:History_and_founding",
                  "original_text": "As of the 2024–2025 academic year, the school offered classes from preschool through third grade, with plans to expand one grade level per year up to high school.[5][1] It is open to students of all backgrounds and faiths.",
                  "source_ref": "s2"
                },
                {
                  "locator": "section:Enrollment_and_growth",
                  "original_text": "By early 2025, enrollment had reached approximately 100 students in pre-K through third grade",
                  "source_ref": "s2"
                },
                {
                  "locator": "section:Campus_and_facilities",
                  "original_text": "Facilities available at the time of purchase included eight main buildings, a gym, a cafeteria with a full kitchen, classrooms, sports fields, and administrative offices.",
                  "source_ref": "s2"
                }
              ],
              "id": "c1",
              "value": {
                "language": "en",
                "text": "Burhan Academy is a private Islamic school in Elgin, Illinois, United States. It occupies the historic campus of Elgin Academy, which closed in 2024. Founded by Yasir Nadeem al Wajidi in 2024, the school combines an Islamic educational approach with conventional academic subjects. Its intended educational range extends from preschool through twelfth grade.\n\nDuring the 2024–2025 academic year, Burhan Academy offered classes from preschool through third grade and planned to add grade levels. Enrollment had reached approximately 100 pupils by early 2025. The school welcomes pupils from different backgrounds and faiths. Its campus includes academic buildings, a gymnasium, a cafeteria, sports fields and administrative offices."
              },
              "verification": "supported"
            }
          ],
          "preferred": {
            "candidate_id": "c1",
            "reason_code": "only_available"
          }
        },
